-- IMPORTANT: This schema ships to user devices (SQLite user_version 1). Any
-- structural change here — adding/removing/renaming columns or tables — MUST
-- come with a numbered .sqm migration file next to this one (1.sqm, 2.sqm, …)
-- so existing installs upgrade in place. Editing the CREATE TABLE alone only
-- affects fresh installs; existing databases keep the old structure and the
-- generated queries will fail against them. Message *content* is not affected:
-- it is stored as JSON with ignoreUnknownKeys, so fields can evolve freely
-- inside messageJson/shellTranscriptJson without a schema migration.

CREATE TABLE conversationEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    type TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    shellTranscriptJson TEXT NOT NULL
);

CREATE TABLE messageEntity (
    conversationId TEXT NOT NULL,
    orderIndex INTEGER NOT NULL,
    messageJson TEXT NOT NULL,
    PRIMARY KEY (conversationId, orderIndex)
);

CREATE TABLE messagePayloadEntity (
    conversationId TEXT NOT NULL,
    orderIndex INTEGER NOT NULL,
    chunkIndex INTEGER NOT NULL,
    content TEXT NOT NULL,
    PRIMARY KEY (conversationId, orderIndex, chunkIndex)
);

selectPayloadChunks:
SELECT content FROM messagePayloadEntity
WHERE conversationId = ? AND orderIndex = ? ORDER BY chunkIndex;

insertPayloadChunk:
INSERT INTO messagePayloadEntity VALUES (?, ?, ?, ?);

deletePayloadChunks:
DELETE FROM messagePayloadEntity WHERE conversationId = ? AND orderIndex >= ?;

deleteMessagePayload:
DELETE FROM messagePayloadEntity WHERE conversationId = ? AND orderIndex = ?;

deleteMessagesFrom:
DELETE FROM messageEntity WHERE conversationId = ? AND orderIndex >= ?;

deleteAllPayloadChunks:
DELETE FROM messagePayloadEntity;

selectAllConversations:
SELECT * FROM conversationEntity ORDER BY createdAt, id;

-- Android reads rows through a CursorWindow that holds ~2 MB; a single row
-- larger than that aborts the whole query with SQLiteBlobTooBigException. New
-- messages are trimmed to a byte budget before insert, and this filter skips
-- oversized rows written by older versions so those databases still load.
-- length(CAST(x AS BLOB)) counts UTF-8 bytes, not characters.
selectAllMessages:
SELECT conversationId, orderIndex,
    CASE WHEN length(CAST(messageJson AS BLOB)) <= :maxBytes THEN messageJson
    ELSE '{"legacyLength":' || length(messageJson) || '}' END AS messageJson
FROM messageEntity ORDER BY conversationId, orderIndex;

selectLegacyMessageChunk:
SELECT substr(messageJson, :start, :count) FROM messageEntity
WHERE conversationId = :conversationId AND orderIndex = :orderIndex;

upsertConversation:
INSERT OR REPLACE INTO conversationEntity (id, title, type, createdAt, updatedAt, shellTranscriptJson)
VALUES (?, ?, ?, ?, ?, ?);

updateShellTranscript:
UPDATE conversationEntity SET shellTranscriptJson = ? WHERE id = ?;

deleteConversation:
DELETE FROM conversationEntity WHERE id = ?;

insertMessage:
INSERT OR REPLACE INTO messageEntity (conversationId, orderIndex, messageJson)
VALUES (?, ?, ?);

deleteMessages:
DELETE FROM messageEntity WHERE conversationId = ?;

deleteAllConversations:
DELETE FROM conversationEntity;

deleteAllMessages:
DELETE FROM messageEntity;
